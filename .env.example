# ============================================================
# ElecAgent · 环境变量模板
# 复制为 .env 后填入真实值。.env 已被 .gitignore 屏蔽。
# ============================================================

# ---------- 智谱开放平台 ----------
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL_LIGHT=glm-4.7-flash
ZHIPU_MODEL_VISION=glm-4.6v-flash
ZHIPU_MODEL_EMBED=embedding-3

# ---------- 本地推理（可选，离线档位）----------
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=glm4
EMBED_LOCAL_MODEL=BAAI/bge-m3

# ---------- GitHub ----------
GITHUB_TOKEN=
GITHUB_USER=
GITHUB_EMAIL=

# ---------- 演示运行参数 ----------
# 模型档位：local | gpu | hybrid
MODEL_PROFILE=hybrid
# 虚拟时钟（对应方案第 8 章的 demo_clock）
DEMO_EVENT=EVT-01
DEMO_NOW=2025-11-26T06:00:00+08:00
